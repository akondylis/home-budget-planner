{
  "title": "Home Budget: how a click reaches the database",
  "subtitle": "The renderer only calls window.api; each call crosses the preload bridge as a 'domain:action' channel to a thin handler and its service.",
  "output": "docs/diagrams/architecture",
  "lanes": [
    {
      "id": "renderer",
      "name": "Renderer",
      "tagline": "React UI · window.api only",
      "color": "#1f6feb"
    },
    {
      "id": "preload",
      "name": "Preload",
      "tagline": "contextBridge bridge",
      "color": "#8250df"
    },
    {
      "id": "main",
      "name": "Main",
      "tagline": "ipc/<domain>.ts → services/",
      "color": "#bc4c00"
    }
  ],
  "domains": [
    {
      "id": "member",
      "title": "Members",
      "screen": [
        "Settings › Household",
        "Sidebar chip (who is using)"
      ],
      "handler": "ipc/member.ts",
      "service": [
        "services/members.ts"
      ],
      "store": "SQLite · Member",
      "calls": [
        {
          "api": "listMembers",
          "channel": "member:list"
        },
        {
          "api": "createMember",
          "channel": "member:create"
        },
        {
          "api": "updateMember",
          "channel": "member:update"
        },
        {
          "api": "archiveMember",
          "channel": "member:archive"
        }
      ]
    },
