{
  "title": "Home Budget: how a click reaches the database",
  "subtitle": "The renderer only calls window.api; each call crosses the preload bridge as a 'domain:action' channel to a thin handler and its service.",
  "output": "docs/diagrams/architecture",
  "lanes": [
    { "id": "renderer", "name": "Renderer", "tagline": "React UI · window.api only", "color": "#1f6feb" },
    { "id": "preload", "name": "Preload", "tagline": "contextBridge bridge", "color": "#8250df" },
    { "id": "main", "name": "Main", "tagline": "ipc/<domain>.ts → services/", "color": "#bc4c00" }
  ],
  "domains": [
    {
      "id": "settings",
      "title": "Settings",
      "screen": ["Settings page", "Title bar badge"],
      "handler": "ipc/settings.ts",
      "service": ["services/settings.ts", "user-data.ts (portable)"],
      "store": "SQLite · AppSettings (Prisma)",
      "calls": [
        { "api": "getSettings", "channel": "settings:get" },
        { "api": "setLanguage", "channel": "settings:setLanguage" },
        { "api": "setDateFormat", "channel": "settings:setDateFormat" },
        { "api": "getAppInfo", "channel": "settings:appInfo" },
        { "api": "openDataDir", "channel": "settings:openDataDir" }
      ]
    },
    {
      "id": "pdf",
      "title": "PDF export",
      "screen": ["Report preview modal", "(Overview, Ctrl+K)"],
      "handler": "ipc/pdf.ts",
      "service": ["services/pdf/pdf-export.ts", "services/pdf/report-pdf.ts"],
      "store": "File on disk (save dialog)",
      "calls": [
        { "api": "exportPdf", "channel": "pdf:export" },
        { "api": "openFile", "channel": "shell:openFile" }
      ]
    },
    {
      "id": "window",
      "title": "Window",
      "screen": ["Theme switch", "(title bar, Settings)"],
      "handler": "ipc/window.ts",
      "service": ["nativeTheme", "title bar colours"],
      "store": "No data stored",
      "calls": [
        { "api": "setTheme", "channel": "window:setTheme" }
      ]
    }
  ],
  "local": [
    { "api": "zoom", "note": "Zoom (window.api.zoom) uses webFrame inside the preload, with no IPC." }
  ]
}
