datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

// Money rule: every amount is an Int of minor units (cents), never Float.
// Domain models not built yet (Debt) are
// drafted in docs/domain-model.md and added per feature.

// ── Models ───────────────────────────────────────────────────────────────────

model AppSettings {
  id         Int      @id
  language   String   @default("el")
  dateFormat String   @default("dd/MM/yyyy")
  currency   String   @default("EUR")
  /// Notifications: remind this many days before a bill falls due (a rule can override it)
  notifyLeadDays Int     @default(3)
  /// Notifications: Windows toasts while the app is open
  notifyToasts   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Ledger: accounts, categories, transactions, statement import ─────────────

enum AccountKind {
  CURRENT
  SAVINGS
  CASH
  CREDIT_CARD
  /// Employer meal card (Edenred, Up Hellas): food only, never a transfer source
  MEAL_VOUCHER
}

/// What an institution issues: bank accounts and cards, or meal-voucher cards
enum InstitutionKind {
  BANK
  VOUCHER_ISSUER
}

/// What a category is: drives budgets and stats. Set on the group, inherited by its categories.
enum CategoryType {
  INCOME
  EXPENSE
  BILL
  SUBSCRIPTION
  DEBT
  SAVINGS
}

enum RuleMatch {
  CONTAINS
  STARTS_WITH
  EXACT
}

/// A parent of the household (children are not tracked). Archived, never deleted.
model Member {
  id                  String        @id @default(cuid())
  name                String
  /// Palette key from MEMBER_COLOURS (src/shared/members.ts), never a hex value
  colour              String
  sortOrder           Int           @default(0)
  archivedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactionsFor     Transaction[] @relation("TransactionMember")
  transactionsEntered Transaction[] @relation("TransactionCreatedBy")
  importBatches       ImportBatch[]
  recurringRules      RecurringRule[]
  accountsHeld        Account[]     @relation("AccountHolder")
  cardsHeld           Card[]        @relation("CardHolder")
}

/// One statement source = one account (a credit card is an account of kind CREDIT_CARD)
model Account {
  id                  String        @id @default(cuid())
  name                String
  kind                AccountKind
  /// null = no bank (cash, or a bank not listed)
  institutionId       String?
  institution         Institution?  @relation(fields: [institutionId], references: [id])
  currency            String        @default("EUR")
  openingBalanceCents Int           @default(0)
  openingDate         DateTime
  /// Statement preset key, e.g. "alpha-account"
  importProfile       String?
  /// Custom column map for statements no preset knows; shape validated with zod in the import service
  importMapping       Json?
  /// The parent whose account it is; null = joint
  holderMemberId      String?
  holder              Member?       @relation("AccountHolder", fields: [holderMemberId], references: [id])
  sortOrder           Int           @default(0)
  archivedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactions        Transaction[]
  importBatches       ImportBatch[]
  rules               CategoryRule[]
  cards               Card[]
  recurringRules      RecurringRule[]
}

/// A bank or meal-voucher issuer, edited by the user (Settings → Banks). Archived, never deleted.
/// The starter list has fixed ids `inst_<name>` (migration 20261029120000_institutions_table).
model Institution {
  id              String          @id @default(cuid())
  name            String          @unique
  kind            InstitutionKind @default(BANK)
  /// Statement preset family, "alpha" | "eurobank"; null = the generic preset
  statementPreset String?
  sortOrder       Int             @default(0)
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  accounts        Account[]
}

/// A plastic card on an account: a debit card on a current account, or a main or supplementary card on a credit card account
model Card {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Exactly 4 digits, as printed on the card
  last4          String
  /// null = no one parent (or no members yet)
  holderMemberId String?
  holder         Member?  @relation("CardHolder", fields: [holderMemberId], references: [id])
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, last4])
}

/// Two levels: a group (parentId null) holds categories; `type` lives on both and follows the group
model Category {
  id           String         @id @default(cuid())
  name         String
  parentId     String?
  parent       Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]     @relation("CategoryTree")
  type         CategoryType
  icon         String?
  sortOrder    Int            @default(0)
  /// Unspent money of a month carries into the next (overspending never does)
  carryOver    Boolean        @default(false)
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions Transaction[]
  rules        CategoryRule[]
  budgetLines  BudgetLine[]
  recurringRules RecurringRule[]

  @@unique([parentId, name])
}

/// A booked movement: income > 0, expense < 0. A transfer is two rows sharing transferId.
model Transaction {
  id                String       @id @default(cuid())
  accountId         String
  account           Account      @relation(fields: [accountId], references: [id])
  /// Date only, stored at 12:00 UTC so it reads as the same day in every time zone
  bookedAt          DateTime
  valueDate         DateTime?
  amountCents       Int
  /// Bank text as exported (trimmed, spaces collapsed); for hand-entered rows the payee or note
  description       String       @default("")
  /// Cleaned name, from a rule or typed by hand
  payee             String?
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id])
  note              String?
  /// Who the row was for; null = the household (shared)
  memberId          String?
  member            Member?      @relation("TransactionMember", fields: [memberId], references: [id])
  /// Who entered or imported it; set once at creation
  createdByMemberId String?
  createdBy         Member?      @relation("TransactionCreatedBy", fields: [createdByMemberId], references: [id])
  transferId        String?
  /// null = entered by hand
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id])
  /// sha256 of account, date, amount, description and occurrence (see docs/domain-model.md)
  fingerprint       String?
  /// Not unique alone: a bank can give the interest and its tax one reference (dedupe keys on reference + amount)
  bankReference     String?
  balanceAfterCents Int?
  /// The due date this row was marked as paying (by hand); matches found on read are not stored
  occurrence        RecurringOccurrence?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([accountId, fingerprint])
  @@index([accountId, bankReference])
  @@index([accountId, bookedAt])
  @@index([bookedAt])
  @@index([categoryId])
  @@index([transferId])
  @@index([importBatchId])
  @@index([memberId])
}

model ImportBatch {
  id            String        @id @default(cuid())
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id])
  fileName      String
  fileHash      String
  dateFrom      DateTime
  dateTo        DateTime
  rowCount      Int
  importedCount Int
  skippedCount  Int
  /// Closing balance printed in the statement (account sign: a card's debt is negative); null when the file has no balance column
  statementBalanceCents Int?
  /// The day that balance belongs to
  statementBalanceDate  DateTime?
  createdByMemberId String?
  createdBy     Member?       @relation(fields: [createdByMemberId], references: [id])
  importedAt    DateTime      @default(now())
  undoneAt      DateTime?
  transactions  Transaction[]

  @@index([accountId, fileHash])
}

/// Merchant rule: the first match by priority sets the category (and payee) of an imported row
model CategoryRule {
  id         String    @id @default(cuid())
  /// Normalised payee key (see normalise() in src/shared/search-normalise.ts)
  pattern    String
  match      RuleMatch @default(CONTAINS)
  /// null = all accounts
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id])
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payee      String?
  priority   Int       @default(0)
  hitCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([priority])
}

// ── Budget ───────────────────────────────────────────────────────────────────

/// The plan for one month; lines hold the amounts
model Budget {
  id        String       @id @default(cuid())
  /// "YYYY-MM"
  month     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lines     BudgetLine[]
}

/// Planned amount for one category (never a group) in one month; stored positive, the category type says which way it goes
model BudgetLine {
  id           String   @id @default(cuid())
  budgetId     String
  budget       Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  plannedCents Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

// ── Subscriptions & bills ────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEK
  MONTH
  YEAR
}

/// A mark set by hand on one due date; a matching transaction found on read needs no row
enum OccurrenceStatus {
  PAID
  SKIPPED
}

/// A bill, subscription or regular income: every `interval` weeks, months or years from `anchorDate`. Archived, never deleted.
model RecurringRule {
  id           String                @id @default(cuid())
  name         String
  /// Stored positive; the category type says which way it goes (INCOME in, anything else out)
  amountCents  Int
  /// Electricity, water: any amount matches
  amountVaries Boolean               @default(false)
  categoryId   String
  category     Category              @relation(fields: [categoryId], references: [id])
  /// The account it is paid from (or into); null = any account
  accountId    String?
  account      Account?              @relation(fields: [accountId], references: [id])
  /// Who it is for; null = the household
  memberId     String?
  member       Member?               @relation(fields: [memberId], references: [id])
  frequency    RecurringFrequency
  /// Every N weeks/months/years (quarterly = MONTH × 3, every two weeks = WEEK × 2)
  interval     Int                   @default(1)
  /// The first due date (date only, 12:00 UTC); later dates keep its day of the month, clamped at month end
  anchorDate   DateTime
  /// Last day a payment can fall due; null = open-ended
  endsAt       DateTime?
  /// Bank text that marks a payment, normalised like CategoryRule.pattern; null = the name
  matchText    String?
  /// Remind this many days before a due date; null = the household setting (AppSettings.notifyLeadDays)
  remindDays   Int?
  archivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  occurrences  RecurringOccurrence[]

  @@index([categoryId])
}

/// One due date marked by hand: paid with a given transaction (or with none), or skipped
model RecurringOccurrence {
  id            String           @id @default(cuid())
  ruleId        String
  rule          RecurringRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  status        OccurrenceStatus
  transactionId String?          @unique
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@unique([ruleId, dueDate])
}

// ── Notifications ─────────────────────────────────────────────────────────────

/// Read / hidden / toasted state of a computed notification (the notifications themselves are never stored)
model NotificationState {
  key         String    @id // e.g. 'bill:<ruleId>:<dueDate>'
  readAt      DateTime?
  dismissedAt DateTime?
  /// A Windows toast was shown for it, so it is never shown twice
  toastedAt   DateTime?
  createdAt   DateTime  @default(now())
}
